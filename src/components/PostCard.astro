---
import { siteConfig } from '../../site.config'
import { categoryPath, localizePath, tagPath, type Locale } from '../lib/i18n'
import { formatDate, postUrl, type Post } from '../lib/posts'

export interface Props {
  post: Post
  locale: Locale
}

const { post, locale } = Astro.props

const category = siteConfig.categories.find((item) => item.slug === post.data.category)
const href = localizePath(locale, postUrl(post))
---

<article class="border-b border-line/80 py-6 first:pt-0 last:border-b-0">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
    {
      category && (
        <>
          <span aria-hidden="true">·</span>
          <a
            class="transition-colors hover:text-accent"
            href={localizePath(locale, categoryPath(category.slug))}
          >
            {category.name[locale]}
          </a>
        </>
      )
    }
    <span class="rounded border border-line px-1.5 py-0.5 text-muted">
      {siteConfig.locales[post.data.lang].label}
    </span>
  </div>

  <h2 class="mt-2 font-serif text-xl leading-snug">
    <a class="text-ink transition-colors hover:text-accent" href={href}>{post.data.title}</a>
  </h2>

  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{post.data.description}</p>

  {
    post.data.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap items-center gap-2 text-xs text-muted">
        {post.data.tags.map((tag) => (
          <li>
            <a class="transition-colors hover:text-accent" href={localizePath(locale, tagPath(tag))}>
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
