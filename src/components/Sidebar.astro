---
import { siteConfig } from '../../site.config'
import { localizePath, type Locale } from '../lib/i18n'
import { collectCategories, collectTags, getPosts, postUrl } from '../lib/posts'
import { t } from '../lib/ui'

export interface Props {
  locale: Locale
}

const { locale } = Astro.props
const dict = t(locale)

const posts = await getPosts(locale)
const latest = posts.slice(0, siteConfig.sidebarLatestPosts)
const categories = collectCategories(posts, locale).filter((category) => category.count > 0)
const tags = collectTags(posts).slice(0, siteConfig.tagCloudLimit)
const initial = siteConfig.name.slice(0, 1).toUpperCase()

const cardClass = 'rounded-card border border-line bg-white/60 p-5'
const titleClass = 'font-serif text-base font-bold text-ink'
---

<aside class="space-y-5 lg:sticky lg:top-32">
  <section class={cardClass}>
    <div class="flex items-center gap-3">
      {
        siteConfig.avatar ? (
          <img
            src={siteConfig.avatar}
            alt=""
            width="48"
            height="48"
            class="size-12 rounded-full object-cover"
          />
        ) : (
          <span
            class="grid size-12 shrink-0 place-items-center rounded-full bg-accent-soft font-serif text-xl font-bold text-accent"
            aria-hidden="true"
          >
            {initial}
          </span>
        )
      }
      <div class="min-w-0">
        <p class="font-serif text-lg font-bold text-ink">{siteConfig.name}</p>
        <p class="text-xs text-muted">{siteConfig.tagline[locale]}</p>
      </div>
    </div>
    <p class="mt-3 text-sm text-ink-soft">{siteConfig.bio[locale]}</p>
  </section>

  {
    latest.length > 0 && (
      <section class={cardClass}>
        <h2 class={titleClass}>{dict.latestPosts}</h2>
        <ul class="mt-3 space-y-2.5 text-sm">
          {latest.map((post) => (
            <li>
              <a class="line-clamp-2 text-ink-soft transition-colors hover:text-accent" href={localizePath(locale, postUrl(post))}>
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    categories.length > 0 && (
      <section class={cardClass}>
        <h2 class={titleClass}>{dict.categories}</h2>
        <ul class="mt-3 space-y-1.5 text-sm">
          {categories.map((category) => (
            <li class="flex items-center justify-between gap-2">
              <a
                class="text-ink-soft transition-colors hover:text-accent"
                href={localizePath(locale, category.url)}
              >
                {category.name}
              </a>
              <span class="text-xs text-muted">{category.count}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    tags.length > 0 && (
      <section class={cardClass}>
        <h2 class={titleClass}>{dict.tags}</h2>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <a
              class="rounded border border-line px-2 py-0.5 text-xs text-ink-soft transition-colors hover:border-accent hover:text-accent"
              href={localizePath(locale, tag.url)}
            >
              {tag.term}
              <span class="ml-1 text-muted">{tag.count}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</aside>
