---
export interface Heading {
  depth: number
  slug: string
  text: string
}

export interface Props {
  headings: Heading[]
  title: string
}

const { headings, title } = Astro.props

// 只用二、三级标题，标题层级太深时目录会变得没法看
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
---

{
  items.length > 0 && (
    <nav class="rounded-card border border-line bg-white/60 p-5" aria-label={title}>
      <h2 class="font-serif text-base font-bold text-ink">{title}</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        {items.map((heading) => (
          <li class={heading.depth === 3 ? 'pl-4' : ''}>
            <a class="text-ink-soft transition-colors hover:text-accent" href={`#${heading.slug}`}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
