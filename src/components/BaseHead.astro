---
import { siteConfig } from '../../site.config'
import {
  absoluteUrl,
  localeMeta,
  locales,
  localizePath,
  toAbsolute,
  type Locale,
} from '../lib/i18n'

export interface Props {
  locale: Locale
  /** 该页面的逻辑路径（不含语言前缀） */
  path: string
  /** 页面标题，不含站名 */
  title?: string
  description?: string
  /** 该页面真实存在的其他语言版本，用于 hreflang */
  alternates?: Partial<Record<Locale, string>>
  type?: 'website' | 'article'
  publishedTime?: Date
}

const {
  locale,
  path,
  title,
  description,
  alternates = {},
  type = 'website',
  publishedTime,
} = Astro.props

const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · ${siteConfig.tagline[locale]}`
const pageDescription = description ?? siteConfig.tagline[locale]
const canonical = absoluteUrl(locale, path)

const defaultLocale = siteConfig.defaultLocale
const xDefault = locale === defaultLocale ? canonical : alternates[defaultLocale]
const ogImage = siteConfig.ogImage ? new URL(siteConfig.ogImage, siteConfig.siteUrl).href : undefined
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonical} />

{
  locales.map((item) => {
    const href = item === locale ? canonical : alternates[item]
    // hreflang 必须是绝对网址
    return href ? (
      <link rel="alternate" hreflang={localeMeta(item).htmlLang} href={toAbsolute(href)} />
    ) : null
  })
}
{xDefault && <link rel="alternate" hreflang="x-default" href={toAbsolute(xDefault)} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={localeMeta(locale).ogLocale} />
{
  locales
    .filter((item) => item !== locale)
    .map((item) => <meta property="og:locale:alternate" content={localeMeta(item).ogLocale} />)
}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{ogImage && <meta property="og:image" content={ogImage} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<link rel="icon" type="image/svg+xml" href={localizePath(defaultLocale, '/favicon.svg')} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteConfig.name} RSS`}
  href={absoluteUrl(locale, '/rss.xml')}
/>

{
  siteConfig.analyticsToken ? (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${siteConfig.analyticsToken}"}`}
    />
  ) : null
}
