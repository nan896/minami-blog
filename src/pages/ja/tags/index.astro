---
import { collectTags, getPosts } from '../../../lib/posts'
import { t } from '../../../lib/ui'
import TaxonomyView from '../../../views/TaxonomyView.astro'

const dict = t('ja')
const posts = await getPosts('ja')
const items = collectTags(posts).map((tag) => ({
  name: tag.term,
  count: tag.count,
  url: tag.url,
}))
---

<TaxonomyView
  locale="ja"
  path="/tags/"
  kicker={dict.tags}
  title={dict.allTags}
  items={items}
  emptyText={dict.noPosts}
/>
