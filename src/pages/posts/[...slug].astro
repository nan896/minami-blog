---
import { getPosts, getSiblings } from '../../lib/posts'
import PostView from '../../views/PostView.astro'

export async function getStaticPaths() {
  const posts = await getPosts('zh')

  return posts.map((post) => ({
    params: { slug: post.data.key },
    props: { post, ...getSiblings(posts, post) },
  }))
}

const { post, newer, older } = Astro.props
---

<PostView locale="zh" post={post} newer={newer} older={older} />
