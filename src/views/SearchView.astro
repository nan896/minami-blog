---
import BaseLayout from '../layouts/BaseLayout.astro'
import type { Locale } from '../lib/i18n'
import { t } from '../lib/ui'

export interface Props {
  locale: Locale
}

const { locale } = Astro.props
const dict = t(locale)
---

<BaseLayout locale={locale} path="/search/" title={dict.search} sidebar={false}>
  <h1 class="font-serif text-2xl text-ink">{dict.search}</h1>
  <p class="mt-2 text-sm text-muted">{dict.searchHint}</p>

  <div
    class="mt-6"
    id="pagefind-search"
    data-empty={dict.searchEmpty}
    data-unavailable={dict.searchUnavailable}
  >
    <label class="sr-only" for="pagefind-input">{dict.searchPlaceholder}</label>
    <input
      id="pagefind-input"
      type="search"
      autocomplete="off"
      placeholder={dict.searchPlaceholder}
      class="w-full rounded-card border border-line bg-white/60 px-4 py-3 text-base text-ink transition-colors outline-none focus:border-accent"
    />
    <p id="pagefind-status" class="mt-3 text-sm text-muted" role="status" aria-live="polite"></p>
    <ul id="pagefind-results" class="mt-6 space-y-6"></ul>
  </div>
</BaseLayout>

<script>
  // 搜索索引由 `pagefind --site dist` 在构建后生成，所以本地 `pnpm dev` 里搜不了，
  // 要先用 pnpm build && pnpm preview 打开这个页面。
  const root = document.getElementById('pagefind-search')

  if (root) {
    const input = document.getElementById('pagefind-input') as HTMLInputElement | null
    const status = document.getElementById('pagefind-status')
    const list = document.getElementById('pagefind-results')
    const emptyText = root.dataset.empty ?? ''
    const unavailableText = root.dataset.unavailable ?? ''

    const base = import.meta.env.BASE_URL.replace(/\/$/, '')
    let modulePromise: Promise<any> | null = null
    let timer: number | undefined

    function loadPagefind() {
      if (!modulePromise) {
        modulePromise = import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`)
      }
      return modulePromise
    }

    function withBase(url: string) {
      return base && !url.startsWith(base) ? `${base}${url}` : url
    }

    function render(results: any[]) {
      if (!list) return
      list.textContent = ''
      for (const result of results) {
        const item = document.createElement('li')

        const link = document.createElement('a')
        link.href = withBase(result.url)
        link.className = 'font-serif text-lg text-ink transition-colors hover:text-accent'
        link.textContent = result.meta?.title ?? result.url

        const excerpt = document.createElement('p')
        excerpt.className = 'mt-1 text-sm text-ink-soft'
        // excerpt 里带有 <mark> 标签，用 innerHTML 才能保留高亮
        excerpt.innerHTML = result.excerpt ?? ''

        item.append(link, excerpt)
        list.append(item)
      }
    }

    async function run(query: string) {
      if (!list || !status) return
      list.textContent = ''
      if (query.trim() === '') {
        status.textContent = ''
        return
      }

      let pagefind: any
      try {
        pagefind = await loadPagefind()
      } catch {
        status.textContent = unavailableText
        return
      }

      const search = await pagefind.search(query)
      const results = await Promise.all(
        search.results.slice(0, 12).map((result: any) => result.data()),
      )

      status.textContent = results.length === 0 ? emptyText : ''
      render(results)
    }

    input?.addEventListener('input', () => {
      window.clearTimeout(timer)
      timer = window.setTimeout(() => void run(input.value), 200)
    })
  }
</script>
