---
import { render } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import type { Locale } from '../lib/i18n'
import { getPage } from '../lib/posts'
import { t } from '../lib/ui'

export interface Props {
  locale: Locale
}

const { locale } = Astro.props
const dict = t(locale)

const page = await getPage('about', locale)
const Content = page ? (await render(page)).Content : undefined
---

<BaseLayout
  locale={locale}
  path="/about/"
  title={page?.data.title ?? dict.about}
  description={page?.data.description}
  sidebar={false}
>
  {
    page && Content ? (
      <>
        <h1 class="font-serif text-2xl text-ink">{page.data.title}</h1>
        <div class="mt-6 article-body">
          <Content />
        </div>
      </>
    ) : (
      <p class="text-sm text-muted">{dict.noPosts}</p>
    )
  }
</BaseLayout>
