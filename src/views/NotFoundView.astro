---
import BaseLayout from '../layouts/BaseLayout.astro'
import { localizePath, type Locale } from '../lib/i18n'
import { t } from '../lib/ui'

export interface Props {
  locale: Locale
}

const { locale } = Astro.props
const dict = t(locale)
---

<BaseLayout locale={locale} path="/404/" title={dict.notFoundTitle} sidebar={false}>
  <div class="py-16 text-center">
    <p class="font-serif text-5xl text-line">404</p>
    <h1 class="mt-4 font-serif text-2xl text-ink">{dict.notFoundTitle}</h1>
    <p class="mt-3 text-sm text-ink-soft">{dict.notFoundBody}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4 text-sm">
      <a
        class="rounded-card border border-line px-4 py-2 text-ink-soft transition-colors hover:border-accent hover:text-accent"
        href={localizePath(locale, '/')}
      >
        {dict.backToHome}
      </a>
      {
        locale === 'zh' && (
          <a class="text-accent" href={localizePath('ja', '/')}>
            日本語のページへ
          </a>
        )
      }
    </div>
  </div>
</BaseLayout>
