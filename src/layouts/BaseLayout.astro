---
// 字体只引入粗体一个字重：标题用衬线，正文走系统无衬线栈。
// 字体是自托管的（@fontsource），不请求任何外部 CDN——Google Fonts 在中国大陆不可达。
import '@fontsource/noto-serif-jp/700.css'
import '@fontsource/noto-serif-sc/700.css'

import '../styles/global.css'

import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Sidebar from '../components/Sidebar.astro'
import { localeMeta, localizePath, locales, type Locale } from '../lib/i18n'
import { t } from '../lib/ui'

export interface Props {
  locale: Locale
  /** 该页面的逻辑路径（不含语言前缀） */
  path: string
  title?: string
  description?: string
  /** 该页面真实存在的其他语言版本（用于 hreflang） */
  alternates?: Partial<Record<Locale, string>>
  /** 语言切换的兜底目标：某语言没有对应页面时去哪儿 */
  switcherFallback?: Partial<Record<Locale, string>>
  type?: 'website' | 'article'
  publishedTime?: Date
  /** 是否显示右侧栏 */
  sidebar?: boolean
}

const {
  locale,
  path,
  title,
  description,
  alternates = {},
  switcherFallback = {},
  type,
  publishedTime,
  sidebar = true,
} = Astro.props

// 语言切换按钮的目标：有对应页面就跳对应页面，否则用页面指定的兜底，再否则留在同一路径
const targets = Object.fromEntries(
  locales.map((item) => [
    item,
    item === locale
      ? localizePath(item, path)
      : (switcherFallback[item] ?? alternates[item] ?? localizePath(item, path)),
  ]),
) as Record<Locale, string>

const dict = t(locale)
---

<!doctype html>
<html lang={localeMeta(locale).htmlLang}>
  <head>
    <BaseHead
      locale={locale}
      path={path}
      title={title}
      description={description}
      alternates={alternates}
      type={type}
      publishedTime={publishedTime}
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-30 focus:rounded focus:bg-paper focus:px-3 focus:py-2 focus:text-accent focus:shadow"
    >
      {dict.skipToContent}
    </a>

    <Header locale={locale} path={path} targets={targets} />

    <main id="main" class="mx-auto w-full max-w-page flex-1 px-5 py-8">
      <div
        class={sidebar
          ? 'grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_280px]'
          : 'mx-auto max-w-3xl'}
      >
        <div class="min-w-0">
          <slot />
        </div>
        {sidebar && <Sidebar locale={locale} />}
      </div>
    </main>

    <Footer locale={locale} />
  </body>
</html>
